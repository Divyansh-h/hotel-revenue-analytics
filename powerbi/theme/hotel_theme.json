{
  "name": "Hotel Analytics",
  "dataColors": [
    "#1A365D",
    "#C05621",
    "#0D7680",
    "#6B21A8",
    "#334155",
    "#854D0E",
    "#9F1239",
    "#3730A3"
  ],
  "background": "#FFFFFF",
  "foreground": "#252423",
  "tableAccent": "#1A365D",
  "good": "#2E7D32",
  "neutral": "#F9A825",
  "bad": "#C62828",
  "maximum": "#2E7D32",
  "center": "#F9A825",
  "minimum": "#C62828",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI",
      "fontSize": 28,
      "color": "#252423"
    },
    "title": {
      "fontFace": "Segoe UI",
      "fontSize": 14,
      "color": "#252423"
    },
    "header": {
      "fontFace": "Segoe UI",
      "fontSize": 12,
      "color": "#252423"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#718096"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontFace": "Segoe UI",
            "fontSize": 14,
            "fontColor": {
              "solid": {
                "color": "#252423"
              }
            },
            "alignment": "left"
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "radius": 4
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    }
  }
}
